# ==============================================================================
# JobTracker AI - Environment Variables & Security Configuration
# ==============================================================================
# All client-side environment variables in Vite must start with VITE_
# IMPORTANT: Never commit your real .env file with secrets to Git.
# ==============================================================================

# AI Provider selection: omniroute | openrouter | ollama | huggingface | custom
VITE_AI_PROVIDER=omniroute

# OmniRoute (Free Models & High-Performance Gateway)
VITE_OMNIROUTE_API_KEY=your_openrouter_or_omniroute_api_key_here
VITE_OMNIROUTE_BASE_URL=https://openrouter.ai/api/v1
VITE_OMNIROUTE_MODEL=qwen/qwen-2.5-72b-instruct:free

# OpenRouter (Alternative Gateway)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local Ollama / LM Studio (100% Offline & Private on your machine)
VITE_LOCAL_OLLAMA_URL=http://localhost:11434/v1
VITE_LOCAL_OLLAMA_MODEL=qwen2.5:7b

# Hugging Face Inference API
VITE_HUGGINGFACE_API_KEY=your_hf_token_here
VITE_HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Custom OpenAI-Compatible Local/Remote Endpoint
VITE_CUSTOM_BASE_URL=http://localhost:8000/v1
VITE_CUSTOM_API_KEY=
VITE_CUSTOM_MODEL=default

# Generation Hyperparameters
VITE_AI_TEMPERATURE=0.3
VITE_AI_MAX_TOKENS=4000
