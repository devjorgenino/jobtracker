{
  "manifest_version": 3,
  "name": "JobTracker AI - Extractor de Vacantes",
  "version": "1.1.0",
  "description": "Captura en 1-clic ofertas de empleo remoto de LinkedIn, Indeed, InfoJobs, CompuTrabajo, Get on Board y sincronízalas con tu JobTracker.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Guardar en JobTracker AI"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/scrapers/generic.js",
        "content/scrapers/linkedin.js",
        "content/scrapers/indeed.js",
        "content/scrapers/infojobs.js",
        "content/scrapers/computrabajo.js",
        "content/scrapers/getonbrd.js",
        "content/scrapers/glassdoor.js",
        "content/scrapers/torre.js",
        "content/scrapers/weworkremotely.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-floating-widget": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Mostrar u ocultar el widget flotante de JobTracker"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
